<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.Zevira" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">#0A0B0F</item>
    </style>

    <!-- Native SplashScreen API Theme -->
    <style name="Theme.Zevira.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0B0F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_zevira_star</item>
        <item name="postSplashScreenTheme">@style/Theme.Zevira</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
