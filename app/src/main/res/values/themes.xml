<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.Zevira" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Native SplashScreen API Theme -->
    <style name="Theme.Zevira.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/electric_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_zevira_star</item>
        <item name="postSplashScreenTheme">@style/Theme.Zevira</item>
    </style>
</resources>
